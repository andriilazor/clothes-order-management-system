# Local settings. Copy to .env or export before running a service.
# Values here are for local development only.

# Ordering
# PostgreSQL from deploy/docker-compose.yml; leave unset to use an in-memory SQLite database.
ORDERING_DATABASE_URL=postgresql+asyncpg://coms:coms_dev_password@localhost:5432/ordering_db
# development: migrate and seed demo carts at start; any other value: migrate only.
ORDERING_ENVIRONMENT=development
